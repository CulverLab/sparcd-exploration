{
  "name": "sparcd-shard-proxy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "smoke": "node smoke.mjs",
    "dev:up": "docker compose -f compose.dev.yaml up -d --wait",
    "dev:down": "docker compose -f compose.dev.yaml down -v",
    "dev:smoke": "S3_ACCESS_KEY_ID=smokekey S3_SECRET_ACCESS_KEY=smokesecret node smoke.mjs --base https://localhost --ports 8443,8444,8445,8446 --bucket smoke-test --insecure",
    "test": "node --test access/test/unit.test.mjs",
    "test:integration": "node --test access/test/integration.test.mjs",
    "access": "node access/server.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1058.0"
  }
}
