{
  "name": "sparcd-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:slow": "E2E_LATENCY_MS=150 playwright test"
  },
  "dependencies": {
    "@smithy/signature-v4": "5.4.6",
    "@sparcd/auth-ui": "workspace:*",
    "@sparcd/s3-safe": "workspace:*",
    "@sparcd/types": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "aws4fetch": "^1.0.20",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.4"
  }
